@model StandingsPageViewModel
@{
    var topAttacking = Model.Standings.OrderByDescending(t => t.GoalsFor).FirstOrDefault();
    var topDefending = Model.Standings.OrderBy(t => t.GoalsAgainst).FirstOrDefault();
    var relLineTeam = Model.Standings.FirstOrDefault(t => t.Position == 18) ?? Model.Standings.LastOrDefault();
}
<section class="summary-section" aria-label="Haftanın öne çıkanları">
  <div class="row g-3">
    <div class="col-sm-6 col-xl-3">
      <article class="stat-card stat-card--leader">
        <div class="stat-card__icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M8 4h8v5a4 4 0 0 1-8 0V4z"/><path d="M8 6H5v1a3 3 0 0 0 3 3M16 6h3v1a3 3 0 0 1-3 3M12 13v4M9 20h6"/></svg>
        </div>
        <div class="stat-card__body">
          <p class="stat-card__label" data-shaolin-text="Büyük Usta">Lider</p>
          <p class="stat-card__team">
            @if (Model.Standings.Any())
            {
                var lead = Model.Standings.First();
                <span class="team-crest team-crest--sm" style="--crest-a:@lead.ColorA;--crest-b:@lead.ColorB;" aria-hidden="true">@lead.TeamCode</span>
                @lead.TeamName
            }
            else { <span>-</span> }
          </p>
          <p class="stat-card__note">@Model.LeaderPoints puan ile zirvede</p>
        </div>
        <p class="stat-card__value">@Model.LeaderPoints<small>puan</small></p>
      </article>
    </div>

    <div class="col-sm-6 col-xl-3">
      <article class="stat-card stat-card--attack">
        <div class="stat-card__icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="8.5"/><path d="M12 7.6l3.3 2.4-1.3 3.8h-4l-1.3-3.8z"/></svg>
        </div>
        <div class="stat-card__body">
          <p class="stat-card__label" data-shaolin-text="Altın Bacak · en golcü">En Çok Gol Atan</p>
          <p class="stat-card__team">
            @if (topAttacking != null)
            {
                <span class="team-crest team-crest--sm" style="--crest-a:@topAttacking.ColorA;--crest-b:@topAttacking.ColorB;" aria-hidden="true">@topAttacking.TeamCode</span>
                @topAttacking.TeamName
            }
          </p>
          <p class="stat-card__note">Toplam @Model.TotalGoals lig golü</p>
        </div>
        <p class="stat-card__value">@(topAttacking?.GoalsFor ?? 0)<small>gol</small></p>
      </article>
    </div>

    <div class="col-sm-6 col-xl-3">
      <article class="stat-card stat-card--defence">
        <div class="stat-card__icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6z"/></svg>
        </div>
        <div class="stat-card__body">
          <p class="stat-card__label" data-shaolin-text="Demir Gömlek · en sağlam savunma">En Az Gol Yiyen</p>
          <p class="stat-card__team">
            @if (topDefending != null)
            {
                <span class="team-crest team-crest--sm" style="--crest-a:@topDefending.ColorA;--crest-b:@topDefending.ColorB;" aria-hidden="true">@topDefending.TeamCode</span>
                @topDefending.TeamName
            }
          </p>
          <p class="stat-card__note">Maç başı @Model.GoalAveragePerMatch gol ort.</p>
        </div>
        <p class="stat-card__value">@(topDefending?.GoalsAgainst ?? 0)<small>gol</small></p>
      </article>
    </div>

    <div class="col-sm-6 col-xl-3">
      <article class="stat-card stat-card--danger">
        <div class="stat-card__icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 7l6 6 4-4 6 6M20 10v5h-5"/></svg>
        </div>
        <div class="stat-card__body">
          <p class="stat-card__label" data-shaolin-text="Çırak Hattı">Düşme Hattı Başlangıcı</p>
          <p class="stat-card__team">
            @if (relLineTeam != null)
            {
                <span class="team-crest team-crest--sm" style="--crest-a:@relLineTeam.ColorA;--crest-b:@relLineTeam.ColorB;" aria-hidden="true">@relLineTeam.TeamCode</span>
                @relLineTeam.TeamName
            }
          </p>
          <p class="stat-card__note">18. sıra barajı</p>
        </div>
        <p class="stat-card__value">18.<small>sıra</small></p>
      </article>
    </div>
  </div>
</section>
