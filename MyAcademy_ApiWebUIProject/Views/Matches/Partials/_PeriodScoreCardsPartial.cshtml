@model MatchDetailViewModel
<div class="period-cards">
  <article class="period-card">
    <p class="period-card__label">İlk yarı</p>
    <p class="period-card__score">@Model.FirstHalfHomeGoals-@Model.FirstHalfAwayGoals</p>
    <p class="period-card__note">
      @(Model.FirstHalfHomeGoals > Model.FirstHalfAwayGoals ? $"{Model.HomeTeam.Name} önde" :
        Model.FirstHalfAwayGoals > Model.FirstHalfHomeGoals ? $"{Model.AwayTeam.Name} önde" : "Beraberlik")
    </p>
  </article>
  <article class="period-card">
    <p class="period-card__label">İkinci yarı</p>
    <p class="period-card__score">@Model.SecondHalfHomeGoals-@Model.SecondHalfAwayGoals</p>
    <p class="period-card__note">
      @(Model.SecondHalfHomeGoals > Model.SecondHalfAwayGoals ? $"{Model.HomeTeam.Name} önde" :
        Model.SecondHalfAwayGoals > Model.SecondHalfHomeGoals ? $"{Model.AwayTeam.Name} önde" : "Beraberlik")
    </p>
  </article>
  <article class="period-card period-card--final">
    <p class="period-card__label">Sonuç</p>
    <p class="period-card__score">@(Model.HomeScore ?? 0)-@(Model.AwayScore ?? 0)</p>
    <p class="period-card__note">
      @if (Model.Status == "Finished")
      {
          @( (Model.HomeScore ?? 0) > (Model.AwayScore ?? 0) ? $"{Model.HomeTeam.Name} kazandı" :
             (Model.AwayScore ?? 0) > (Model.HomeScore ?? 0) ? $"{Model.AwayTeam.Name} kazandı" : "Berabere bitti" )
      }
      else
      {
          <span>@Model.StatusName</span>
      }
    </p>
  </article>
</div>
