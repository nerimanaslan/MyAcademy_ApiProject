@model MatchDetailViewModel
@{
    var scoreText = Model.HomeScore.HasValue && Model.AwayScore.HasValue ? $"{Model.HomeScore}-{Model.AwayScore}" : "-";
    ViewData["Title"] = $"{Model.HomeTeam.Name} {scoreText} {Model.AwayTeam.Name} | Maç Detayı";
    ViewData["BodyClass"] = "match-page";
}

@section Styles {
    <link rel="stylesheet" href="~/css/match-detail.css" asp-append-version="true">
}

<!-- SVG sembolleri (partial'larda <use href="#i-..."> ile kullanılır) -->
<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <symbol id="i-ball" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M12 7.4l3.4 2.5-1.3 4h-4.2l-1.3-4z" fill="currentColor"/><path d="M12 3v4.4M20.5 9.3l-5.1.6M17.4 19.4l-3.3-5.5M6.6 19.4l3.3-5.5M3.5 9.3l5.1.6" fill="none" stroke="currentColor" stroke-width="1.4"/></symbol>
  <symbol id="i-swap" viewBox="0 0 24 24"><path d="M7 4v14M3.5 7.5L7 4l3.5 3.5M17 20V6M13.5 16.5L17 20l3.5-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></symbol>
  <symbol id="i-calendar" viewBox="0 0 24 24"><rect x="3.5" y="5" width="17" height="15" rx="2.5" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M3.5 10h17M8 3v4M16 3v4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></symbol>
  <symbol id="i-clock" viewBox="0 0 24 24"><circle cx="12" cy="12" r="8.5" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M12 7.5V12l3 2" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></symbol>
  <symbol id="i-stadium" viewBox="0 0 24 24"><ellipse cx="12" cy="9" rx="9" ry="3.5" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M3 9v6c0 1.9 4 3.5 9 3.5s9-1.6 9-3.5V9" fill="none" stroke="currentColor" stroke-width="1.8"/></symbol>
  <symbol id="i-whistle" viewBox="0 0 24 24"><circle cx="9" cy="14" r="5" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M12.5 10.5L21 6v4l-5.5 2" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></symbol>
</svg>

@* data-match-scene: scenes.js giriş sahnesi bu bilgilerle oynar *@
<main class="match-shell container-xl" data-match data-match-scene
      data-match-id="@Model.Id" data-week="@Model.Week" data-status="@Model.StatusName" data-derby="@Model.DerbyName"
      data-stadium="@(string.IsNullOrEmpty(Model.Stadium) ? Model.HomeTeam.Stadium : Model.Stadium)"
      data-home-name="@Model.HomeTeam.Name" data-home-code="@Model.HomeTeam.Code" data-home-a="@Model.HomeTeam.ColorA" data-home-b="@Model.HomeTeam.ColorB"
      data-away-name="@Model.AwayTeam.Name" data-away-code="@Model.AwayTeam.Code" data-away-a="@Model.AwayTeam.ColorA" data-away-b="@Model.AwayTeam.ColorB"
      data-home-score="@(Model.HomeScore.HasValue && Model.AwayScore.HasValue ? Model.HomeScore.ToString() : "")"
      data-away-score="@(Model.HomeScore.HasValue && Model.AwayScore.HasValue ? Model.AwayScore.ToString() : "")">
    <partial name="Partials/_MatchHeroPartial" model="Model" />

    <div class="match-body">
        <div class="row g-4">
            <div class="col-lg-8">
                <partial name="Partials/_MatchTimelinePartial" model="Model" />
                <partial name="Partials/_GoalsPartial" model="Model" />
                <partial name="Partials/_CardsPartial" model="Model" />
                <partial name="Partials/_SubstitutionsPartial" model="Model" />
            </div>

            <aside class="col-lg-4 side-col" aria-label="Maç özeti ve istatistikler">
                <partial name="Partials/_ChiMeterPartial" model="Model" />
                <partial name="Partials/_PeriodScoreCardsPartial" model="Model" />
                <partial name="Partials/_MatchStatsPartial" model="Model" />
                <partial name="Partials/_MatchInfoCardPartial" model="Model" />
            </aside>
        </div>
    </div>

    <p class="page-note">Serie A Resmi İstatistik Portalı — Canlı Veri Akışı</p>
</main>

@section Scripts {
    <script src="~/js/match-detail.js" asp-append-version="true"></script>
    <script src="~/js/replay.js" asp-append-version="true"></script>
}
