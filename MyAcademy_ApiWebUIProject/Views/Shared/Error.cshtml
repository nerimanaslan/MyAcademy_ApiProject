@model ErrorViewModel
@{
    ViewData["Title"] = "Hata";
    ViewData["BodyClass"] = "standings-page";
}

@section Styles {
    <link rel="stylesheet" href="~/css/standings.css" asp-append-version="true">
}

<main class="standings-shell container-xl">
    <header class="standings-hero">
        <div class="hero-league"><span class="league-mark" aria-hidden="true">SA</span>Serie A</div>
        <h1 class="hero-title">Bir hata oluştu</h1>
        <p class="hero-subtitle">İsteğiniz işlenirken beklenmeyen bir sorun çıktı. API projesinin çalıştığından emin olup tekrar deneyin.</p>
        @if (Model.ShowRequestId)
        {
            <p class="hero-subtitle">İstek kimliği: <code>@Model.RequestId</code></p>
        }
        <p style="margin-top:16px"><a asp-controller="Standings" asp-action="Index" style="color:var(--blue-bright)">Puan durumuna dön &rarr;</a></p>
    </header>
</main>
