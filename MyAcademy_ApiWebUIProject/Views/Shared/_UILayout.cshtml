@inject IConfiguration Configuration
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] | Serie A</title>
    @* Şaolin modu tercihi: sayfa çizilmeden önce uygulanır ki tema yanıp sönmesin *@
    <script>try { if (localStorage.getItem('serieA.shaolin') === 'on') document.documentElement.dataset.shaolin = 'on'; } catch (e) { }</script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600;700&family=Barlow+Condensed:wght@500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.3/css/bootstrap.min.css">
    <link rel="stylesheet" href="~/css/public.css" asp-append-version="true">
    @await RenderSectionAsync("Styles", required: false)
    <link rel="stylesheet" href="~/css/effects.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/shaolin.css" asp-append-version="true">
</head>
<body class="@ViewData["BodyClass"]" data-hub-url="@Configuration["ApiSettings:HubUrl"]">
    @await RenderSectionAsync("BodyTop", required: false)

    <partial name="_ApiStatusPartial" />
    <partial name="_PublicNav" />

    @RenderBody()

    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    <script src="~/js/effects.js" asp-append-version="true"></script>
    <script src="~/js/scenes.js" asp-append-version="true"></script>
    <script src="~/js/shaolin.js" asp-append-version="true"></script>
    <script src="~/js/live.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
